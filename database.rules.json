{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && auth.uid === $uid",
        ".write": "(auth != null && auth.token.email_verified === true && auth.uid === $uid) || auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['username', 'color', 'initials'])",
        "username": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 25"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().matches(/^(red|gold|teal|blue|pink|olive|orange|purple|brown|silver)$/)"
        },
        "initials": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{1,3}$/)"
        },
        "$other": {
          ".validate": false
        },
        "style": {
          ".validate": "newData.isString() && newData.val().matches(/^(game-show|arcade|rec-room)$/)"
        },
        "symbol": {
          ".validate": "newData.isString() && newData.val().matches(/^(wolf|fox|bear|owl|cat|dog|pig|rabbit|frog|turtle|penguin|bee|star|moon|rocket|crown)$/)"
        }
      },
      ".read": "auth != null && (auth.token.email_verified === true || root.child('admins').child(auth.uid).val() === true)"
    },
    "rooms": {
      "$code": {
        ".read": "auth != null && auth.token.email_verified === true",
        ".write": "(auth != null && auth.token.email_verified === true && !data.exists() && newData.child('host').val() === auth.uid) || (auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists()) || (auth != null && data.child('host').val() === auth.uid && !newData.exists())",
        ".validate": "$code.matches(/^[A-Z]{4}$/)",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid && data.parent().parent().child('host').exists()",
            ".validate": "auth.uid === $uid && newData.hasChildren(['username', 'initials', 'color', 'joinedAt'])",
            "username": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 25"
            },
            "initials": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{1,3}$/)"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^(red|gold|teal|blue|pink|olive|orange|purple|brown|silver)$/)"
            },
            "symbol": {
              ".validate": "newData.isString() && newData.val().matches(/^(wolf|fox|bear|owl|cat|dog|pig|rabbit|frog|turtle|penguin|bee|star|moon|rocket|crown)$/)"
            },
            "joinedAt": {
              ".validate": "newData.val() === now || (data.exists() && newData.val() === data.val())"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "play": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid",
          ".validate": "newData.hasChildren(['state', 'startedAt']) && newData.child('state').isString()",
          "startedAt": {
            ".validate": "newData.isNumber()"
          },
          "deadline": {
            ".validate": "newData.isNumber()"
          },
          "state": {
            ".validate": "newData.isString()"
          },
          "$other": {
            ".validate": false
          }
        },
        "session": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid && data.parent().child('lobby').val() === true",
          "planned": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20"
          },
          "ended": {
            ".validate": "newData.isBoolean()"
          },
          "games": {
            "$resultId": {
              ".validate": "newData.hasChildren(['game', 'at', 'points']) && newData.child('game').isString() && newData.child('at').isNumber()",
              "points": {
                "$uid": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
                }
              }
            }
          }
        },
        "progress": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid && !newData.exists()",
          "$id": {
            ".write": "auth != null && auth.token.email_verified === true && ((auth.uid === $id && data.parent().parent().child('players').child(auth.uid).exists()) || (data.parent().parent().child('host').val() === auth.uid && $id.beginsWith('bot-')))",
            ".validate": "newData.isString() && newData.val().length <= 2000"
          }
        },
        "game": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid && data.parent().child('lobby').val() === true",
          ".validate": "newData.isString() && newData.val().matches(/^[a-z-]{1,40}$/)"
        },
        "votes": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid && !newData.exists()",
          "$uid": {
            ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid && data.parent().parent().child('players').child(auth.uid).exists()",
            ".validate": "newData.isString() && newData.val().matches(/^[a-z-]{1,40}$/)"
          }
        },
        "host": {
          ".validate": "newData.isString() && newData.val().length <= 128",
          ".write": "auth != null && data.val() === auth.uid && newData.exists() && data.parent().child('players').child(newData.val()).exists()"
        },
        "lobby": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      },
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "results": {
      ".read": "auth != null && auth.token.email_verified === true",
      "$resultId": {
        ".write": "(auth != null && auth.token.email_verified === true && !data.exists() && newData.child('room').isString() && $resultId.beginsWith(newData.child('room').val() + '-') && root.child('rooms').child(newData.child('room').val()).child('host').val() === auth.uid) || (auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists())",
        ".validate": "newData.hasChildren(['game', 'room', 'at', 'players'])",
        "game": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z-]{1,40}$/)"
        },
        "room": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{4}$/)"
        },
        "at": {
          ".validate": "newData.val() === now"
        },
        "size": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50"
        },
        "players": {
          "$uid": {
            ".validate": "newData.hasChildren(['place', 'points']) && newData.child('place').isNumber() && newData.child('place').val() >= 1 && newData.child('place').val() <= 50 && newData.child('points').isNumber() && newData.child('points').val() >= 0 && newData.child('points').val() <= 100 && root.child('rooms').child(newData.parent().parent().child('room').val()).child('players').child($uid).exists()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && auth.uid !== $uid",
        ".validate": "newData.isBoolean() && newData.val() === true"
      }
    },
    "playtesters": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isBoolean()"
      }
    },
    "roomSecrets": {
      "$code": {
        ".write": "(auth != null && root.child('rooms').child($code).child('host').val() === auth.uid && !newData.exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists())",
        "host": {
          ".read": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
          ".validate": "newData.isString()"
        },
        "views": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length <= 1000000"
          }
        },
        "inputs": {
          ".read": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
          "$id": {
            ".write": "auth != null && auth.token.email_verified === true && ((!data.exists() && newData.exists() && root.child('rooms').child($code).child('players').child(auth.uid).exists()) || (!newData.exists() && root.child('rooms').child($code).child('host').val() === auth.uid))",
            ".validate": "newData.hasChildren(['by', 'input'])",
            "by": {
              ".validate": "newData.val() === auth.uid"
            },
            "input": {
              ".validate": "newData.isString() && newData.val().length <= 200000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "scoreAdjustments": {
      ".read": "auth != null && auth.token.email_verified === true",
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['uid', 'points', 'reason', 'by', 'at'])",
        "uid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "points": {
          ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 1000"
        },
        "reason": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "by": {
          ".validate": "newData.val() === auth.uid"
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "game": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z-]{1,40}$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "scoreResets": {
      ".read": "auth != null && auth.token.email_verified === true",
      "everyone": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isNumber() && newData.val() <= now"
      },
      "players": {
        "$uid": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.isNumber() && newData.val() <= now"
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
