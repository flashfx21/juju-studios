{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && auth.uid === $uid",
        ".write": "(auth != null && auth.token.email_verified === true && auth.uid === $uid) || auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['username', 'color', 'initials'])",
        "username": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 25"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().matches(/^(red|gold|teal|blue|pink|olive|orange|purple|brown|silver)$/)"
        },
        "initials": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{1,3}$/)"
        },
        "$other": {
          ".validate": false
        },
        "style": {
          ".validate": "newData.isString() && newData.val().matches(/^(game-show|arcade|rec-room)$/)"
        },
        "symbol": {
          ".validate": "newData.isString() && newData.val().matches(/^(wolf|fox|bear|owl|cat|dog|pig|rabbit|frog|turtle|penguin|bee|star|moon|rocket|crown)$/)"
        }
      },
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "rooms": {
      "$code": {
        ".read": "auth != null && auth.token.email_verified === true",
        ".write": "auth != null && auth.token.email_verified === true && !data.exists() && newData.child('host').val() === auth.uid",
        ".validate": "$code.matches(/^[A-Z]{4}$/)",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid && data.parent().parent().child('host').exists()",
            ".validate": "newData.hasChildren(['username', 'initials', 'color', 'joinedAt'])",
            "username": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 25"
            },
            "initials": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{1,3}$/)"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^(red|gold|teal|blue|pink|olive|orange|purple|brown|silver)$/)"
            },
            "symbol": {
              ".validate": "newData.isString() && newData.val().matches(/^(wolf|fox|bear|owl|cat|dog|pig|rabbit|frog|turtle|penguin|bee|star|moon|rocket|crown)$/)"
            }
          }
        },
        "play": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid",
          ".validate": "newData.hasChildren(['state']) && newData.child('state').isString()"
        },
        "inputs": {
          "$id": {
            ".write": "auth != null && auth.token.email_verified === true && data.parent().parent().child('host').exists() && ((!data.exists() && newData.child('by').val() === auth.uid && data.parent().parent().child('players').child(auth.uid).exists()) || (!newData.exists() && data.parent().parent().child('host').val() === auth.uid))"
          }
        },
        "progress": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid && !newData.exists()",
          "$id": {
            ".write": "auth != null && auth.token.email_verified === true && ((auth.uid === $id && data.parent().parent().child('players').child(auth.uid).exists()) || (data.parent().parent().child('host').val() === auth.uid && $id.beginsWith('bot-')))",
            ".validate": "newData.isString() && newData.val().length <= 2000"
          }
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "playtesters": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isBoolean()"
      }
    }
  }
}
