{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && auth.token.email_verified === true",
        ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true",
        ".validate": "newData.hasChildren(['username', 'color', 'initials'])",
        "username": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 16"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().matches(/^(red|gold|teal|blue|pink|olive)$/)"
        },
        "initials": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{1,3}$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
